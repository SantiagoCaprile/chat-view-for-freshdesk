{
  "manifest_version": 3,
  "name": "Chat View for Freshdesk",
  "version": "1.7.2",
  "description": "Read tickets as a chat: only the new text of each email, without the quoted history. Read-only.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.freshdesk.com/a/*"
      ],
      "js": [
        "i18n.js",
        "clean.js",
        "content.js"
      ],
      "css": [
        "chat.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "chat.css"
      ],
      "matches": [
        "https://*.freshdesk.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chat View for Freshdesk",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Chat View"
}
